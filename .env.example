# =============================================================================
# Variables d'environnement — copier vers .env.local et remplir les valeurs
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend : envoi des devis, factures, relances et sauvegardes
RESEND_API_KEY=
# Expéditeur (ex. "NG Gestion <contact@votre-domaine.fr>")
RESEND_FROM=

# URL publique du site (liens de signature envoyés aux clients)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry (facultatif : sans DSN, désactivé)
NEXT_PUBLIC_SENTRY_DSN=

# --- Tâches planifiées (voir docs/rappels-push.md)
# Secret attendu par /api/cron/quotidien depuis Vercel Cron (openssl rand -hex 32)
CRON_SECRET=
# Secret attendu par /api/cron/rappels-push ET accepté par /api/cron/quotidien
# quand l'appel vient de pg_cron (Supabase)
PUSH_CRON_SECRET=
# Clé service role (crons uniquement, jamais côté navigateur)
SUPABASE_SERVICE_ROLE_KEY=
# Notifications push (web-push, clés VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://facture-green.vercel.app
